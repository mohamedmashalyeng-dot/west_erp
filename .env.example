# ---------------------------------------------------------------------------
# EstateIQ environment configuration (copy to `.env` and adjust)
# ---------------------------------------------------------------------------

# MySQL 8+ / MariaDB 10.11+. On Hostinger use the database URL from hPanel.
# localhost refers to the server running the app, not your development PC.
DATABASE_URL="mysql://root:password@127.0.0.1:3307/estateiq"

# Local MariaDB development server (requires portable MariaDB binaries).
# Set MYSQL_BIN_DIR to the MariaDB bin directory to use npm run db:start.
MYSQL_BIN_DIR=""
DEV_DATABASE_PORT="3307"
DEV_DATABASE_DIR=".mysql-data"
DEV_DATABASE_USER="root"
DEV_DATABASE_PASSWORD="password"
DEV_DATABASE_NAME="estateiq"
TEST_DATABASE_NAME="estateiq_test"
# Optional existing test server. The database must already exist and its name
# must start with test_ or end with _test. Production DATABASE_URL is never used.
TEST_DATABASE_URL=""

# Auth.js
# Generate with: npx auth secret   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_TRUST_HOST="true"
APP_URL="http://localhost:3000"
SESSION_MAX_AGE_SECONDS="28800"

# Facebook Lead Ads (see docs/facebook-leads.md). Keep these server-side.
FACEBOOK_APP_SECRET=""
FACEBOOK_WEBHOOK_VERIFY_TOKEN=""
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key stable: changing it requires reconnecting stored Page tokens.
FACEBOOK_TOKEN_ENCRYPTION_KEY=""
FACEBOOK_GRAPH_API_VERSION="v27.0"

# AI provider abstraction: mock | openai | anthropic | gemini
# `mock` runs the deterministic local provider: fully functional, no API key needed.
AI_PROVIDER="mock"
AI_MODEL=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Optional seed overrides
SEED_DEFAULT_PASSWORD="Password123!"

# Platform (super) admin bootstrap, created by the seeder
PLATFORM_ADMIN_EMAIL="platform@estateiq.dev"

# Production: first organization + owner, created by `npm run db:bootstrap`
# (also run by `vercel-build`). Leave BOOTSTRAP_OWNER_EMAIL empty to skip.
# The password is only used when the user does not exist yet.
BOOTSTRAP_ORG_NAME=""
BOOTSTRAP_OWNER_EMAIL=""
BOOTSTRAP_OWNER_PASSWORD=""
BOOTSTRAP_OWNER_NAME=""
